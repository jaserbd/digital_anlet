NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://anlet:anlet@localhost:5432/anlet?schema=public"

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Seed-time bootstrap admin account (idempotent upsert, seeded into an internal org)
ADMIN_EMAIL=admin@anlet.local
ADMIN_PASSWORD=change-me-in-production

# Password-reset email delivery (any SMTP relay/provider — SendGrid, SES, Postmark, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASSWORD=change-me
SMTP_FROM=no-reply@example.com

# Frontend origin used to build the emailed reset link (dev: Vite's own port, not the backend's)
APP_BASE_URL=http://localhost:5173
