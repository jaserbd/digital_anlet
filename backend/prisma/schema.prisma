generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  NORMAL_USER
  EXECUTIVE
  ADMIN
}

enum AnswerOption {
  A
  B
  C
  D
}

enum ResponseStatus {
  IN_PROGRESS
  SUBMITTED
}

model Organization {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
  opCos OpCo[]
  questionnaireOrgSettings QuestionnaireOrgSetting[]
}

// A NatCo/OpCo within an Organization (e.g. "Vodafone Kenya" under "Vodafone Group").
// Admin-managed, same pattern as Organization. Users self-select their OpCo (which encodes
// their Country + Company) during profile completion — see User.opCoId.
model OpCo {
  id        String   @id @default(cuid())
  name      String
  country   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  users User[]

  @@unique([organizationId, name])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  firstName    String?
  lastName     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // True for every admin-created account (single-create and bulk-CSV alike) — the admin-set
  // password is explicitly one-time; the user must set their own on first login (OVERVIEW.md
  // item 4). Cleared by PUT /api/auth/change-password. Defaults false so existing/seeded
  // accounts (notably the bootstrap Admin, created outside createUser) are unaffected.
  mustChangePassword Boolean @default(false)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Nullable: filled in by the user themselves at profile completion, not at admin
  // creation time. A NORMAL_USER with opCoId == null is routed to /profile before
  // reaching the domain picker (see CLAUDE.md "Profile completion"). Not required for
  // EXECUTIVE/ADMIN, who don't answer questionnaires.
  opCoId String?
  opCo   OpCo?   @relation(fields: [opCoId], references: [id])

  workingDomain String?
  designation   String?

  responses QuestionnaireResponse[]
  passwordResetTokens PasswordResetToken[]
}

// Forgot-password flow (OVERVIEW.md item 12) — a single-use, expiring token emailed as a
// reset link. Only the token's hash is stored (mirrors why User.passwordHash is hashed, not
// plaintext) so a DB leak alone can't be used to redeem outstanding reset links.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Generic questionnaire model: RAN Fault Management (GB1059A), Core Network Fault
// Management + Core Network Stability (GB1059B) — see CLAUDE.md "Domain model".
model Questionnaire {
  id                 String   @id @default(cuid())
  code               String   @unique // e.g. "RAN_FM_GB1059A", "CORE_FM_GB1059B"
  name               String
  networkType        String // "RAN" | "Core" | ... — also the top-level "Domain" in the UI picker
  hvsCategory        String // "Fault Management" | "Stability" | ... — the HVS within that domain
  // false only for Core Network Stability: it has no sub-scenarios, so there's no
  // per-sub-scenario S/P grid to show (see CLAUDE.md "Domain model").
  hasE2ECheck        Boolean  @default(true)
  // Questionnaire-level context extracted from the xlsx's Guideline sheet (Introduction +
  // Sub-scenarios for RAN; the numbered Introduction for Core FM/Stability). Shown as a
  // collapsible section above the question flow (SECOND_REVIEW.md item 4).
  guidelineText      String?  @db.Text
  version            Int      @default(1)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  subScenarios SubScenario[]
  questions    Question[]
  responses    QuestionnaireResponse[]
  orgSettings  QuestionnaireOrgSetting[]
}

// Admin-controlled per-(questionnaire, organization) open/close toggle (THIRD_REVIEW.md item
// 7) — replaced a single global Questionnaire.acceptingResponses boolean, since a large
// multi-org deployment needs to close one organization's acceptance without affecting
// others. While true, a response stays fully mutable (including re-submitting) regardless of
// its status; once false, every mutation for that org is blocked, including for
// already-SUBMITTED responses. Absence of a row (shouldn't normally happen — every
// org/questionnaire pair is backfilled on creation, see organizations.service.ts and
// seed.ts) defaults to true. See questionnaire.service.ts/responses.service.ts.
model QuestionnaireOrgSetting {
  questionnaireId    String
  questionnaire      Questionnaire @relation(fields: [questionnaireId], references: [id])
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id])
  acceptingResponses Boolean       @default(true)
  updatedAt          DateTime      @updatedAt

  @@id([questionnaireId, organizationId])
}

model SubScenario {
  id          String  @id @default(cuid())
  // Plain string, not an enum — sub-scenario identities are questionnaire-specific (RAN's
  // 5 codes, Core FM's 2, Core Stability's single synthetic "OVERALL"), not a fixed global
  // set. Unique per questionnaire, see @@unique below.
  code        String
  name        String
  description String? @db.Text

  // Share of real-world fault distribution; used both to weight the final score and to
  // compute the E2E automation rate. Not required to sum to 1 across a questionnaire's
  // sub-scenarios (RAN FM's 5 do; Core FM's 2 sum to 0.9 by design — the xlsx's own final
  // score formula normalizes by dividing by the weight sum, and so does scoring.ts). See
  // CLAUDE.md.
  faultDistributionWeight Decimal @db.Decimal(5, 4)
  sortOrder               Int

  questionnaireId String
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id])

  answers                 Answer[]
  subScenarioScoreResults SubScenarioScoreResult[]
  questionScoreResults    QuestionScoreResult[]
  commentTags             QuestionCommentSubScenario[]

  @@unique([questionnaireId, code])
}

model Question {
  id                String  @id @default(cuid())
  sortOrder         Int
  cognitiveActivity String // Intent | Awareness | Analysis | Decision | Execution (IAADE)
  serviceCapability String
  questionText      String  @db.Text
  weight            Decimal @db.Decimal(5, 4) // within-questionnaire weight; all sum to 1

  optionAText String  @db.Text
  optionBText String? @db.Text
  optionCText String? @db.Text
  optionDText String? @db.Text

  // Not every option is scored/used (nullable). A question's own "top score" (needed for
  // the compensation rule, see CLAUDE.md) is derived at read time as the max of these,
  // not stored separately.
  optionACriteria Decimal? @db.Decimal(4, 2)
  optionBCriteria Decimal? @db.Decimal(4, 2)
  optionCCriteria Decimal? @db.Decimal(4, 2)
  optionDCriteria Decimal? @db.Decimal(4, 2)

  // false only for the Intent question — excluded from the E2E Automation Ratio Checklist.
  // The one structural fact that isn't derivable from the criteria data itself.
  includeInE2ECheck Boolean @default(true)

  // Per-question guidance from the xlsx's Guideline sheet ("Answering Guideline" column) —
  // only populated for RAN_FM.xlsx's questions (CORE_FM.xlsx's Guideline sheet has no
  // per-question breakdown, see parseCoreFmXlsx.ts). Shown collapsed on the question card.
  answeringGuideline String? @db.Text

  complianceWithStandards Boolean?
  standardSource          String?  @db.Text

  questionnaireId String
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id])

  answers      Answer[]
  comments     QuestionComment[]
  scoreResults QuestionScoreResult[]

  @@unique([questionnaireId, sortOrder])
}

model QuestionnaireResponse {
  id          String         @id @default(cuid())
  status      ResponseStatus @default(IN_PROGRESS)
  submittedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  questionnaireId String
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id])

  answers  Answer[]
  comments QuestionComment[]
  result   ScoreResult?
}

model Answer {
  id             String       @id @default(cuid())
  selectedOption AnswerOption
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  responseId String
  response   QuestionnaireResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id])

  subScenarioId String
  subScenario   SubScenario @relation(fields: [subScenarioId], references: [id])

  @@unique([responseId, questionId, subScenarioId])
}

// One comment per question per response — the user's explanation, optionally tagged to
// specific sub-scenarios (via QuestionCommentSubScenario) or to none of them
// (appliesToNone). An unanswered (question, subScenario) pair must be covered by a comment
// tagged to that subScenario (or an appliesToNone comment on that question) before the
// response can be submitted — see responses.service.ts submitResponse. Terminology: an
// unanswered pair with no covering comment blocks submission; once covered, it's a "skip"
// (submittable, scored via re-normalization — see scoring.ts).
model QuestionComment {
  id            String   @id @default(cuid())
  commentText   String   @db.Text
  appliesToNone Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  responseId String
  response   QuestionnaireResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id])

  subScenarios QuestionCommentSubScenario[]

  @@unique([responseId, questionId])
}

model QuestionCommentSubScenario {
  commentId String
  comment   QuestionComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  subScenarioId String
  subScenario   SubScenario @relation(fields: [subScenarioId], references: [id])

  @@id([commentId, subScenarioId])
}

// Write-once snapshot computed by the pure scoring module (backend/src/modules/scoring)
// and persisted at submit time — not recomputed live on every dashboard read.
model ScoreResult {
  id                String   @id @default(cuid())
  finalScore        Decimal  @db.Decimal(6, 4)
  e2eAutomationRate Decimal  @db.Decimal(6, 4)
  computedAt        DateTime @default(now())

  responseId String                @unique
  response   QuestionnaireResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  subScenarioScores SubScenarioScoreResult[]
  questionScores    QuestionScoreResult[]
}

model SubScenarioScoreResult {
  id           String   @id @default(cuid())
  // Null only when every question in this sub-scenario was left unanswered — excluded from
  // the final-score weighted average in that case (see scoring.ts).
  overallScore Decimal? @db.Decimal(6, 4)
  e2eAchieved  Boolean

  scoreResultId String
  scoreResult   ScoreResult @relation(fields: [scoreResultId], references: [id], onDelete: Cascade)

  subScenarioId String
  subScenario   SubScenario @relation(fields: [subScenarioId], references: [id])

  @@unique([scoreResultId, subScenarioId])
}

// Per-question, per-sub-scenario breakdown of a ScoreResult — one row per (question,
// subScenario) pair, including unanswered ones (both scores null there). Feeds the
// results-page score matrix (SECOND_REVIEW.md item 7) without needing to recompute scoring
// live; the compensated score is what actually contributes to the parent
// SubScenarioScoreResult's weighted average (see scoring.ts).
model QuestionScoreResult {
  id               String   @id @default(cuid())
  originalScore    Decimal? @db.Decimal(6, 4)
  compensatedScore Decimal? @db.Decimal(6, 4)

  scoreResultId String
  scoreResult   ScoreResult @relation(fields: [scoreResultId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id])

  subScenarioId String
  subScenario   SubScenario @relation(fields: [subScenarioId], references: [id])

  @@unique([scoreResultId, questionId, subScenarioId])
}
